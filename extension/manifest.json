{
  "manifest_version": 3,
  "name": "Tab Topics",
  "short_name": "Tab Topics",
  "version": "0.1.0",
  "description": "Save tabs into topics with to_be_ordered / ordered / done queues, per-entry notes, rule-based topic suggestions, search, and JSON export/import.",
  "permissions": ["tabs", "storage", "favicon"],
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Tab Topics",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Ctrl+Shift+Space" },
      "description": "Open the Tab Topics popup"
    },
    "save-tab": {
      "suggested_key": { "default": "Alt+Shift+U" },
      "description": "Save current tab to a topic (quick picker)"
    },
    "add-note": {
      "suggested_key": { "default": "Alt+Shift+N" },
      "description": "Add or edit the note on the current tab"
    }
  }
}
